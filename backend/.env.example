# =============================================================================
# Backend (web delivery) settings — prefix CLVN_
# These are SEPARATE from the RAG core's .env (LLM/embedding/store endpoints).
# In dev, both files can live at the repo root; pydantic reads the prefix it
# owns. Never commit real secrets.
# =============================================================================

# --- Database (async SQLAlchemy URL) ---
CLVN_DATABASE_URL="postgresql+asyncpg://clvn:clvn@localhost:5432/clvn"
CLVN_DB_ECHO=false

# --- JWT ---  (MUST set a 32+ byte random secret in production)
CLVN_JWT_SECRET="change-me-to-a-long-random-string-min-32-bytes"
CLVN_JWT_ALGORITHM="HS256"
CLVN_ACCESS_TOKEN_TTL_MINUTES=30
CLVN_REFRESH_TOKEN_TTL_DAYS=14

# --- CORS (comma-separated frontend origins) ---
CLVN_CORS_ORIGINS="http://localhost:3000"

# --- Bootstrap admin (created on first startup if no admin exists) ---
CLVN_BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
CLVN_BOOTSTRAP_ADMIN_PASSWORD="ChangeMe!123"

# --- App ---
CLVN_API_PREFIX="/api/v1"
CLVN_PROJECT_NAME="chat-legal-vn"
