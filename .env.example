# =============================================================================
# 1. LLM (Generation, Query Decomposition, HyDE, Judge)
#    MIMO API — OpenAI-compatible
# =============================================================================
LLM_BASE_URL="https://token-plan-sgp.xiaomimimo.com/v1"
LLM_API_KEY="sk-your_mimo_api_key_here"
LLM_MODEL_NAME="mimo-v2.5-pro"
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# =============================================================================
# 2. EMBEDDING — Qwen3-Embedding-8B served by vLLM (OpenAI-compatible)
#    Started with: vllm serve Qwen/Qwen3-Embedding-8B --runner pooling
#                  --convert embed --port 8001 --max-model-len 8192
#    Output dim: 4096 (full).  MRL allowed: any 32..4096.
#    Context length on the model card: 32k (server may cap with --max-model-len).
# =============================================================================
EMBEDDING_BASE_URL="http://localhost:8001/v1"
EMBEDDING_API_KEY="sk-dummy-key"
EMBEDDING_MODEL_NAME="Qwen/Qwen3-Embedding-8B"
EMBEDDING_DIM=4096
# Documents per single /v1/embeddings request. vLLM batches across
# concurrent requests automatically, but a 64-128 micro-batch saturates
# the GPU per call and cuts request overhead.
EMBEDDING_BATCH_SIZE=64
# Max embedding requests in flight at once. vLLM continuous batching
# turns concurrent requests into a single GPU step → 4-8× throughput vs
# serial. Bump higher only if your network can handle it.
EMBEDDING_CONCURRENCY=4
EMBEDDING_MAX_INPUT_TOKENS=8192
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_MAX_RETRIES=4
EMBEDDING_TASK_INSTRUCTION="Given a Vietnamese legal question, retrieve relevant Vietnamese legal documents (laws, decrees, circulars, decisions) that answer the question."

# =============================================================================
# 3. RERANKER — Qwen3-Reranker-8B served by vLLM as Qwen3ForSequenceClassification
#    Started with:
#      vllm serve Qwen/Qwen3-Reranker-8B --port 8002 --max-model-len 32768 \
#        --hf_overrides '{"architectures":["Qwen3ForSequenceClassification"], \
#          "classifier_from_token":["no","yes"], \
#          "is_original_qwen3_reranker": true}'
#    Endpoints exposed: /v1/score (single pair) AND /v1/rerank (batch).
# =============================================================================
RERANKER_BASE_URL="http://localhost:8002/v1"
RERANKER_API_KEY="sk-dummy-key"
RERANKER_MODEL_NAME="Qwen/Qwen3-Reranker-8B"
RERANKER_MAX_INPUT_TOKENS=32768
RERANKER_TIMEOUT_SECONDS=60
RERANKER_BATCH_SIZE=32
RERANKER_TASK_INSTRUCTION="Given a Vietnamese legal question, judge whether the candidate Vietnamese legal passage contains the rule that answers the question."

# =============================================================================
# 4. VECTOR STORE — Qdrant
# =============================================================================
VECTOR_STORE_TYPE="qdrant"
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=""
QDRANT_USE_HTTPS=false
# gRPC delivers ~1.2-1.5× write throughput over HTTP for upsert.
QDRANT_PREFER_GRPC=true
# Points per single upsert request. With 4096-dim float32 vectors each
# point is ~18 KiB, so 128 points fits in ~2.3 MiB — well under server
# limits. Bigger batches risk BrokenPipeError on busy hosts.
QDRANT_UPSERT_BATCH_SIZE=128
QDRANT_UPSERT_MAX_RETRIES=4
COLLECTION_NAME="vn_legal_docs"

# =============================================================================
# 5. LEXICAL STORE — Elasticsearch (BM25, Vietnamese-aware analyzer)
# =============================================================================
ELASTICSEARCH_HOST="http://localhost:9200"
ELASTICSEARCH_USER="elastic"
ELASTICSEARCH_PASSWORD="changeme"
ELASTICSEARCH_VERIFY_CERTS=false
# Documents per _bulk request. 256 keeps each request under ~5 MiB.
ELASTICSEARCH_BULK_CHUNK_SIZE=256
# Pause periodic refresh for the duration of a bulk ingest run; refresh
# is forced once at the end so search queries see the data. Roughly
# doubles bulk indexing throughput on a freshly-built index.
ELASTICSEARCH_DISABLE_REFRESH_DURING_INGEST=true
INDEX_NAME="vn_legal_lexical"

# =============================================================================
# 6. GRAPH STORE — Neo4j (cross-document references)
# =============================================================================
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="password"
NEO4J_DATABASE="neo4j"

# =============================================================================
# 7. RETRIEVAL & PIPELINE
# =============================================================================
# Hybrid fusion strategy: "rrf" or "alpha"
HYBRID_FUSION="rrf"
HYBRID_RRF_K=60
HYBRID_ALPHA_DENSE=0.7
HYBRID_ALPHA_SPARSE=0.3

# Number of candidates fetched from each retriever (per sub-query)
RETRIEVER_TOP_K=40

# After reranking, keep at most this many candidates for the LLM
RERANKER_TOP_K=5

# Drop candidates with reranker score below this threshold
RERANKER_THRESHOLD=0.7

# Diversity: max child-chunks per parent article kept after reranking
DIVERSITY_MAX_PER_PARENT=2

# Ingest pipeline concurrency
# Number of flush jobs (embed + upsert) that may run concurrently.
# Setting to 2 overlaps "embedding the next batch" with "upserting the
# previous batch" → ~1.3-1.5× throughput. Higher values gain less and
# cost RAM.
INGEST_FLUSH_CONCURRENCY=2
INGEST_FLUSH_QUEUE_SIZE=4

# Query planner controls
QUERY_DECOMPOSE_ENABLED=true
QUERY_HYDE_ENABLED=true
QUERY_HYDE_NUM=1

# GraphRAG expansion
GRAPH_EXPAND_ENABLED=true
GRAPH_EXPAND_HOPS=1
GRAPH_EXPAND_LIMIT=10

# Versioning (stamped onto every chunk)
CHUNKING_VERSION="v1"
EMBEDDING_VERSION="qwen3-emb-8b-4096-v1"
PROMPT_VERSION="irac-v1"
POLICY_VERSION="hybrid-rrf-rerank-v1"

# =============================================================================
# 8. APP / OPS
# =============================================================================
LOG_LEVEL="INFO"
DATA_DIR="data/vietnamese-legal-documents/data"
HTTP_HOST="0.0.0.0"
HTTP_PORT=8080
